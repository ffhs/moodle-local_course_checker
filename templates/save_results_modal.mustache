{{!
    @template local_course_checker/save_results_modal

    Shows a modal with an input field.

    Example context (json):
    {
        "version_name": "YYYY_MM_DD"
    }
}}
<div class="mb-3">
    <label class="form-label" for="local-course-checker-version-name">
        {{#str}}version_name, local_course_checker{{/str}}
    </label>
    <input type="text" class="form-control" id="local-course-checker-version-name" value="{{version_name}}" maxlength="20" required data-region="version-name">
</div>
